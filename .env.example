# Public site URL used for canonical links, Open Graph, and the sitemap.
# This is a build-time value. The Dockerfile defaults to the production domain.
VITE_SITE_URL=https://amitkumarportfolio.com

# Optional public profile links. Leave blank to hide the button.
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
VITE_EMAIL=
VITE_YOUTUBE_URL=
VITE_RESUME_URL=

# Runtime origin check for comments and the newsletter. Cloud Run sets this.
# The www host is allowed automatically.
PUBLIC_SITE_URL=https://amitkumarportfolio.com

# Optional Cloud Storage bucket for comments and newsletter addresses on Cloud Run.
# Leave empty for a local data/community.json file.
GCS_BUCKET=
GCS_OBJECT=community.json

# Server-only. These are not baked into the site. Used by the discussion and newsletter API.
# Create a long random value and keep it stable so signed-in sessions survive a restart.
SESSION_SECRET=

# Google Cloud OAuth client (Web). Redirect URI: {origin}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft Entra app (Web), personal Microsoft accounts enabled. Redirect URI: {origin}/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Facebook Login app. Redirect URI: {origin}/api/auth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
